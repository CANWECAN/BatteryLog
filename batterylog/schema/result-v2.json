{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CANWECAN/BatteryLog/v0.7.0/batterylog/schema/result-v2.json",
  "title": "BatteryLog Analysis Result v2",
  "description": "First formally frozen machine-readable result contract for BatteryLog, result schema version 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_status",
    "rules_evaluated",
    "limits_applied",
    "analysis_options",
    "comparison_policy",
    "signal_mapping",
    "rows_analyzed",
    "cells_detected",
    "temperature_sensors_detected",
    "max_cell_voltage_v",
    "min_cell_voltage_v",
    "max_delta_v",
    "max_temperature_c",
    "min_temperature_c",
    "violations"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "validation_status": {
      "enum": ["NOT_EVALUATED", "PASS", "FAIL"]
    },
    "rules_evaluated": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ruleCode"
      }
    },
    "limits_applied": {
      "$ref": "#/$defs/limitsApplied"
    },
    "analysis_options": {
      "$ref": "#/$defs/analysisOptions"
    },
    "comparison_policy": {
      "$ref": "#/$defs/comparisonPolicy"
    },
    "signal_mapping": {
      "$ref": "#/$defs/signalMapping"
    },
    "rows_analyzed": {
      "type": "integer",
      "minimum": 1
    },
    "cells_detected": {
      "type": "integer",
      "minimum": 1
    },
    "temperature_sensors_detected": {
      "type": "integer",
      "minimum": 1
    },
    "max_cell_voltage_v": {
      "type": "number"
    },
    "min_cell_voltage_v": {
      "type": "number"
    },
    "max_delta_v": {
      "type": "number",
      "minimum": 0
    },
    "max_temperature_c": {
      "type": "number"
    },
    "min_temperature_c": {
      "type": "number"
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violationEvent"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validation_status": {
            "const": "NOT_EVALUATED"
          }
        },
        "required": ["validation_status"]
      },
      "then": {
        "properties": {
          "rules_evaluated": {
            "maxItems": 0
          },
          "violations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation_status": {
            "const": "PASS"
          }
        },
        "required": ["validation_status"]
      },
      "then": {
        "properties": {
          "rules_evaluated": {
            "minItems": 1
          },
          "violations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation_status": {
            "const": "FAIL"
          }
        },
        "required": ["validation_status"]
      },
      "then": {
        "properties": {
          "rules_evaluated": {
            "minItems": 1
          },
          "violations": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "ruleCode": {
      "enum": [
        "CELL_IMBALANCE_HIGH",
        "CELL_OVERVOLTAGE",
        "CELL_UNDERVOLTAGE",
        "TEMPERATURE_HIGH",
        "TEMPERATURE_LOW"
      ]
    },
    "limitsApplied": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_min_v",
        "cell_max_v",
        "imbalance_max_v",
        "temperature_min_c",
        "temperature_max_c"
      ],
      "properties": {
        "cell_min_v": {
          "$ref": "#/$defs/nullableNumber"
        },
        "cell_max_v": {
          "$ref": "#/$defs/nullableNumber"
        },
        "imbalance_max_v": {
          "$ref": "#/$defs/nullableNumber"
        },
        "temperature_min_c": {
          "$ref": "#/$defs/nullableNumber"
        },
        "temperature_max_c": {
          "$ref": "#/$defs/nullableNumber"
        }
      }
    },
    "analysisOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_event_gap_s"],
      "properties": {
        "max_event_gap_s": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "comparisonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "relative_tolerance",
        "absolute_tolerance"
      ],
      "properties": {
        "mode": {
          "const": "strict_with_binary64_guard"
        },
        "relative_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "absolute_tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "signalMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "timestamp_source",
        "cell_voltage_pattern",
        "temperature_pattern"
      ],
      "properties": {
        "mode": {
          "enum": ["canonical", "explicit"]
        },
        "timestamp_source": {
          "type": "string",
          "minLength": 1
        },
        "cell_voltage_pattern": {
          "type": ["string", "null"]
        },
        "temperature_pattern": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "canonical"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "timestamp_source": {
                "const": "timestamp_s"
              },
              "cell_voltage_pattern": {
                "type": "null"
              },
              "temperature_pattern": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "explicit"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "cell_voltage_pattern": {
                "type": "string",
                "minLength": 1
              },
              "temperature_pattern": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "violationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "start_time_s",
        "end_time_s",
        "peak_time_s",
        "measured_value",
        "limit_value",
        "unit",
        "signals"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ruleCode"
        },
        "start_time_s": {
          "type": "number"
        },
        "end_time_s": {
          "type": "number"
        },
        "peak_time_s": {
          "type": "number"
        },
        "measured_value": {
          "type": "number"
        },
        "limit_value": {
          "type": "number"
        },
        "unit": {
          "enum": ["V", "degC"]
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "CELL_IMBALANCE_HIGH",
                  "CELL_OVERVOLTAGE",
                  "CELL_UNDERVOLTAGE"
                ]
              }
            },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "V"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "TEMPERATURE_HIGH",
                  "TEMPERATURE_LOW"
                ]
              }
            },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "degC"
              }
            }
          }
        }
      ]
    }
  }
}
